@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix wc: <http://www.semanticweb.org/worldcup2022#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://www.semanticweb.org/worldcup2022> a owl:Ontology ;
    rdfs:label "FIFA World Cup 2022 Knowledge Graph Ontology" ;
    rdfs:comment "Schema (TBox) for a Multimedia Information Retrieval KG about the 2022 FIFA World Cup." .

wc:appearances a owl:DatatypeProperty ;
    rdfs:domain wc:Player ;
    rdfs:range xsd:integer .

wc:assistsProvided a owl:DatatypeProperty ;
    rdfs:domain wc:Player ;
    rdfs:range xsd:integer .

wc:awayScore a owl:DatatypeProperty ;
    rdfs:domain wc:Match ;
    rdfs:range xsd:integer .

wc:belongsToConfederation a owl:ObjectProperty ;
    rdfs:label "belongsToConfederation" ;
    rdfs:domain wc:Team ;
    rdfs:range wc:Confederation .

wc:birthDate a owl:DatatypeProperty ;
    rdfs:domain wc:Player ;
    rdfs:range xsd:date .

wc:capacity a owl:DatatypeProperty ;
    rdfs:domain wc:Stadium ;
    rdfs:range xsd:integer .

wc:city a owl:DatatypeProperty ;
    rdfs:domain wc:Stadium ;
    rdfs:range xsd:string .

wc:cleanSheets a owl:DatatypeProperty ;
    rdfs:domain wc:Player ;
    rdfs:range xsd:float .

wc:clubName a owl:DatatypeProperty ;
    rdfs:domain wc:Club ;
    rdfs:range xsd:string .

wc:confederationCode a owl:DatatypeProperty ;
    rdfs:domain wc:Confederation ;
    rdfs:range xsd:string .

wc:confederationName a owl:DatatypeProperty ;
    rdfs:domain wc:Confederation ;
    rdfs:range xsd:string .

wc:country a owl:DatatypeProperty ;
    rdfs:domain wc:Stadium ;
    rdfs:range xsd:string .

wc:draws a owl:DatatypeProperty ;
    rdfs:domain wc:Team ;
    rdfs:range xsd:integer .

wc:dribblesPer90 a owl:DatatypeProperty ;
    rdfs:domain wc:Player ;
    rdfs:range xsd:float .

wc:duelsWonPer90 a owl:DatatypeProperty ;
    rdfs:domain wc:Player ;
    rdfs:range xsd:float .

wc:endDate a owl:DatatypeProperty ;
    rdfs:domain wc:Tournament ;
    rdfs:range xsd:date .

wc:extraTime a owl:DatatypeProperty ;
    rdfs:domain wc:Match ;
    rdfs:range xsd:boolean .

wc:familyName a owl:DatatypeProperty ;
    rdfs:domain wc:Player ;
    rdfs:range xsd:string .

wc:featureVector a owl:DatatypeProperty ;
    rdfs:comment "Serialized image embedding produced in the feature-extraction step." ;
    rdfs:domain wc:PlayerImage ;
    rdfs:range xsd:string .

wc:federationName a owl:DatatypeProperty ;
    rdfs:domain wc:Team ;
    rdfs:range xsd:string .

wc:finalPosition a owl:DatatypeProperty ;
    rdfs:comment "Final ranking of the team in the 2022 tournament (1 = winner)." ;
    rdfs:domain wc:Team ;
    rdfs:range xsd:integer .

wc:folderPath a owl:DatatypeProperty ;
    rdfs:domain wc:PlayerImage ;
    rdfs:range xsd:string .

wc:fullName a owl:DatatypeProperty ;
    rdfs:domain wc:Player ;
    rdfs:range xsd:string .

wc:gamesPlayed a owl:DatatypeProperty ;
    rdfs:domain wc:Team ;
    rdfs:range xsd:integer .

wc:givenName a owl:DatatypeProperty ;
    rdfs:domain wc:Player ;
    rdfs:range xsd:string .

wc:goalDifference a owl:DatatypeProperty ;
    rdfs:domain wc:Team ;
    rdfs:range xsd:integer .

wc:goalForTeam a owl:ObjectProperty ;
    rdfs:label "goalForTeam" ;
    rdfs:domain wc:Goal ;
    rdfs:range wc:Team .

wc:goalsAgainst a owl:DatatypeProperty ;
    rdfs:domain wc:Team ;
    rdfs:range xsd:integer .

wc:goalsFor a owl:DatatypeProperty ;
    rdfs:domain wc:Team ;
    rdfs:range xsd:integer .

wc:goalsScored a owl:DatatypeProperty ;
    rdfs:domain wc:Player ;
    rdfs:range xsd:integer .

wc:groupName a owl:DatatypeProperty ;
    rdfs:domain wc:Match ;
    rdfs:range xsd:string .

wc:hasAwayTeam a owl:ObjectProperty ;
    rdfs:label "hasAwayTeam" ;
    rdfs:domain wc:Match ;
    rdfs:range wc:Team .

wc:hasGoal a owl:ObjectProperty ;
    rdfs:label "hasGoal" ;
    rdfs:domain wc:Match ;
    rdfs:range wc:Goal ;
    owl:inverseOf wc:scoredInMatch .

wc:hasHomeTeam a owl:ObjectProperty ;
    rdfs:label "hasHomeTeam" ;
    rdfs:domain wc:Match ;
    rdfs:range wc:Team .

wc:hasImage a owl:ObjectProperty ;
    rdfs:label "hasImage" ;
    rdfs:domain wc:Player ;
    rdfs:range wc:PlayerImage .

wc:hasPosition a owl:ObjectProperty ;
    rdfs:label "hasPosition" ;
    rdfs:domain wc:Player ;
    rdfs:range wc:Position .

wc:homeScore a owl:DatatypeProperty ;
    rdfs:domain wc:Match ;
    rdfs:range xsd:integer .

wc:hostCountry a owl:DatatypeProperty ;
    rdfs:domain wc:Tournament ;
    rdfs:range xsd:string .

wc:imageCount a owl:DatatypeProperty ;
    rdfs:domain wc:PlayerImage ;
    rdfs:range xsd:integer .

wc:interceptionsPer90 a owl:DatatypeProperty ;
    rdfs:domain wc:Player ;
    rdfs:range xsd:float .

wc:isOwnGoal a owl:DatatypeProperty ;
    rdfs:domain wc:Goal ;
    rdfs:range xsd:boolean .

wc:isPenalty a owl:DatatypeProperty ;
    rdfs:domain wc:Goal ;
    rdfs:range xsd:boolean .

wc:losses a owl:DatatypeProperty ;
    rdfs:domain wc:Team ;
    rdfs:range xsd:integer .

wc:matchDate a owl:DatatypeProperty ;
    rdfs:domain wc:Match ;
    rdfs:range xsd:date .

wc:matchName a owl:DatatypeProperty ;
    rdfs:domain wc:Match ;
    rdfs:range xsd:string .

